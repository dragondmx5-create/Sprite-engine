{
  "name": "sprite-engine",
  "version": "1.1.0",
  "description": "Procedural, deterministic chibi/enemy/loot sprite engine with fake-3D lighting.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --format=esm --outfile=dist/sprite-engine.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/content.ts --bundle --format=esm --platform=node --outfile=dist/content-test.mjs && node dist/content-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71"
  }
}
