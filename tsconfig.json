{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["@webgpu/types"]
  },
  "include": ["src/**/*.ts"]
}
